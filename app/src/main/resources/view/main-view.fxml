<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.image.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.unicam.cs.mpgc.rpg122641.Controllers.StartController"
           style="-fx-background-color: black;">

    <VBox spacing="20" alignment="CENTER" style="-fx-padding: 40;">

        <Label text="ShadowhunterS" style="-fx-text-fill: white; -fx-font-size: 36; -fx-font-weight: bold;"/>

        <ImageView fitWidth="200"
                   preserveRatio="true">

            <image>
                <Image url="@/images/runa.jpg"/>
            </image>

        </ImageView>

        <Label text="Cacciatori di Demoni"
               style="-fx-text-fill: #cccccc; -fx-font-size: 16;"/>

        <Button text="INIZIA" fx:id="btnNew"
                prefWidth="200"
                style="-fx-font-size: 18; -fx-background-color: green;"
                onAction="#goToGame"/>

        <Button text="Riprendi partita" fx:id="btnOld"
                prefWidth="200"
                style="-fx-font-size: 18; -fx-background-color: green;"
                onAction="#goToGame" visible="false"/>
    </VBox>

</StackPane>