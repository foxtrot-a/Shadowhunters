<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.Image?>
<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.unicam.cs.mpgc.rpg122641.Controllers.RoomController"
            style="-fx-background-color: #1b1b1b;">

    <top>
        <Label text="DOVE VUOI ANDARE?"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 28px;
                      -fx-text-fill: white;
                      -fx-padding: 20;"/>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="20">
            <padding>
                <Insets top="20" bottom="20" left="20" right="20"/>
            </padding>

            <!-- Prima riga -->
            <HBox alignment="CENTER" spacing="20">

                <StackPane fx:id="1" prefWidth="160" prefHeight="160"
                           style="-fx-border-color: white;
                                  -fx-border-width: 2;
                                  -fx-background-color: #3b3b3b;"
                           onMouseClicked="#scenario">


                    <ImageView fx:id="img1"
                               fitWidth="150"
                               fitHeight="150"
                               preserveRatio="false">
                        <image>
                            <Image url="@/images/Lago.png"/>
                        </image>

                    </ImageView>
                    <Label text="Lago Lyn"
                           StackPane.alignment="BOTTOM_CENTER"
                           style="-fx-text-fill: white;
              -fx-font-size: 14;
              -fx-background-color: rgba(0,0,0,0.6);
              -fx-padding: 4;"/>

               </StackPane>

                <StackPane fx:id="2" prefWidth="160" prefHeight="160"
                           style="-fx-border-color: white; -fx-border-width: 2; -fx-background-color: #3b3b3b;"
                           onMouseClicked="#scenario">

                    <ImageView fx:id="img2"
                               fitWidth="150"
                               fitHeight="150"
                               preserveRatio="false">
                        <image>
                            <Image url="@/images/silente.png"/>
                        </image>

                    </ImageView>

                    <Label text="Città Silente"
                           StackPane.alignment="BOTTOM_CENTER"
                           style="-fx-text-fill: white;
              -fx-font-size: 14;
              -fx-background-color: rgba(0,0,0,0.6);
              -fx-padding: 4;"/>
                </StackPane>

                <StackPane fx:id="3" prefWidth="160" prefHeight="160"
                           style="-fx-border-color: white; -fx-border-width: 2; -fx-background-color: #3b3b3b;"
                           onMouseClicked="#scenario">
                    <ImageView fx:id="img3"
                               fitWidth="150"
                               fitHeight="150"
                               preserveRatio="false">
                        <image>
                            <Image url="@/images/diamante.png"/>
                        </image>

                    </ImageView>

                   <Label text="Città di Diamante"
                           StackPane.alignment="BOTTOM_CENTER"
                           style="-fx-text-fill: white;
              -fx-font-size: 14;
              -fx-background-color: rgba(0,0,0,0.6);
              -fx-padding: 4;"/>
                </StackPane>

                <StackPane fx:id="4" prefWidth="160" prefHeight="160"
                           style="-fx-border-color: white; -fx-border-width: 2; -fx-background-color: #3b3b3b;"
                           onMouseClicked="#scenario">
                    <ImageView fx:id="img4"
                               fitWidth="150"
                               fitHeight="150"
                               preserveRatio="false">
                        <image>
                            <Image url="@/images/istituto.png"/>
                        </image>

                    </ImageView>

                    <Label text="Istituto di New York"
                           StackPane.alignment="BOTTOM_CENTER"
                           style="-fx-text-fill: white;
              -fx-font-size: 14;
              -fx-background-color: rgba(0,0,0,0.6);
              -fx-padding: 4;"/>
                </StackPane>

            </HBox>


            <HBox alignment="CENTER" spacing="20">

                <StackPane fx:id="5" prefWidth="160" prefHeight="160"
                           style="-fx-border-color: white; -fx-border-width: 2; -fx-background-color: #3b3b3b;"
                           onMouseClicked="#scenario">
                    <ImageView fx:id="img5"
                               fitWidth="150"
                               fitHeight="150"
                               preserveRatio="false">
                        <image>
                            <Image url="@/images/alicante.jpg"/>
                        </image>

                    </ImageView>
                    <Label text="Alicante"
                           StackPane.alignment="BOTTOM_CENTER"
                           style="-fx-text-fill: white;
              -fx-font-size: 14;
              -fx-background-color: rgba(0,0,0,0.6);
              -fx-padding: 4;"/>
                </StackPane>

                <StackPane fx:id="6" prefWidth="160" prefHeight="160"
                           style="-fx-border-color: white; -fx-border-width: 2; -fx-background-color: #3b3b3b;"
                           onMouseClicked="#scenario">
                    <ImageView fx:id="img6"
                               fitWidth="150"
                               fitHeight="150"
                               preserveRatio="false">
                        <image>
                            <Image url="@/images/casa.png"/>
                        </image>

                    </ImageView>
                    <Label text="Casa Blacktorn"
                           StackPane.alignment="BOTTOM_CENTER"
                           style="-fx-text-fill: white;
              -fx-font-size: 14;
              -fx-background-color: rgba(0,0,0,0.6);
              -fx-padding: 4;"/>
                </StackPane>

                <StackPane fx:id="7" prefWidth="160" prefHeight="160"
                           style="-fx-border-color: white; -fx-border-width: 2; -fx-background-color: #3b3b3b;"
                           onMouseClicked="#scenario">
                    <ImageView fx:id="img7"
                               fitWidth="150"
                               fitHeight="150"
                               preserveRatio="false">
                        <image>
                            <Image url="@/images/casa_isabel.png"/>
                        </image>

                    </ImageView>

                    <Label text="Casa Lightwood"
                           StackPane.alignment="BOTTOM_CENTER"
                           style="-fx-text-fill: white;
              -fx-font-size: 14;
              -fx-background-color: rgba(0,0,0,0.6);
              -fx-padding: 4;"/>
                </StackPane>

            </HBox>

        </VBox>
    </center>

</BorderPane>