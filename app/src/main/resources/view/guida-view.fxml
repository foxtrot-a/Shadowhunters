<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="it.unicam.cs.mpgc.rpg122641.Controllers.GuideController"
            style="-fx-background-color: black;">

    <!-- Titolo -->
    <top>
        <Label text="GUIDA DEL GIOCO"
               style="-fx-text-fill: white; -fx-font-size: 28; -fx-padding: 15;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- Guida -->
    <center>
        <TextArea editable="false"
                  wrapText="true"
                  style="-fx-font-size: 14;
                 -fx-control-inner-background: #1e1e1e;
                 -fx-text-fill: white;">
            <text><![CDATA[
Benvenuto nel gioco!

OBIETTIVO:
Sconfiggi i nemici e completa l'avventura.

COMANDI:
• Attacca: infligge danno.
• Difendi: riduce il danno ricevuto.
• Magia: utilizza il mana per lanciare incantesimi.

INVENTARIO:
• Usa gli oggetti raccolti durante il viaggio.
• Cura il personaggio.
• Ottieni vantaggi.

BUONA FORTUNA!
    ]]></text>
        </TextArea>
    </center>

    <!-- Pulsanti -->
    <bottom>
        <HBox alignment="CENTER"
              spacing="20"
              style="-fx-padding: 15; -fx-background-color: #222222;">



            <Button text="Inizia l'avventura"
                    prefWidth="180"
                    onAction="#goToGame"
                    style="
                        -fx-background-color: #4CAF50;
                        -fx-text-fill: white;
                        -fx-font-size: 16;
                        -fx-background-radius: 8;
                    "/>

        </HBox>
    </bottom>

</BorderPane>